# CPV environment template (placeholders only — never commit real secrets)
# Copy to .env.local and fill in real values for development.
# Phase 1 runs in MOCK MODE and requires NONE of these.

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CPV

# ---- Future: Supabase ----
# Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Future: AI provider ----
# Phase 1 uses a deterministic mock. To enable a real provider later, set:
# AI_PROVIDER=mock|openai|huggingface|ollama
AI_PROVIDER=mock
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Future: blockchain / decentralized verification ----
# Not used in Phase 1.
BLOCKCHAIN_NETWORK=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=

# ---- Future: automation (n8n) ----
N8N_WEBHOOK_URL=

# ---- Future: rate limiting ----
# Example: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
